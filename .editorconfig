root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{kt,kts}]
# Android Studio / Kotlin coding conventions. The project is an Android sample app plus a JVM
# library, and this style keeps function signatures and expression bodies compact.
ktlint_code_style = android_studio
# ktlint only enforces a line length when this is set. 120 leaves room for test names and URLs
# without forcing artificial wrapping.
max_line_length = 120
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

[*.{yml,yaml}]
indent_size = 2

[*.md]
# Trailing whitespace is meaningful in Markdown (hard line breaks).
trim_trailing_whitespace = false
